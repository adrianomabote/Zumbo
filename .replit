modules = ["nodejs-20", "web", "bash", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["eas-cli"]

[userenv]

[userenv.development]
NET_SERVICOS_PAYMENT_MODE = "live"
SITE_URL = "https://megabyte.live"

[userenv.production]
NET_SERVICOS_PAYMENT_MODE = "live"
PAGAR_WEBHOOK_URL = "https://megabyte.live/api/pagar/webhook"
SITE_URL = "https://megabyte.live"
DEBITO_API_BASE_URL = "https://gyqoaningqhurhvdugne.supabase.co/functions/v1"
DEBITO_MERCHANT_ID = "c2851daf-decb-4298-a9d8-8a0c58bb2cc6"
DEBITO_WALLET_CODE = "08269"
DEBITO_AMOUNT_MULTIPLIER = "100"
PAYMENT_PROVIDER = "debitopay"
