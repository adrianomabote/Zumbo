# Production environment template for the MozServe VPS.
# Copy to /opt/net-servicos/.env and fill in the values there.
# Never commit the real .env file or paste real credentials into this file.

NODE_ENV=production
PORT=3004
DATABASE_URL=postgresql://megabyte_app:PREENCHA_A_PASSWORD@127.0.0.1:5432/megabyte
NET_SERVICOS_PAYMENT_MODE=live
SITE_URL=https://net-servicos.online
PAGAR_API_BASE_URL=https://api.pagar.co.mz/api/v1
PAGAR_API_KEY=
PAGAR_SIGNING_SECRET=
PAGAR_WEBHOOK_SECRET=
